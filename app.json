{
    "expo":  {
                 "name":  "NBX-go",
                 "slug":  "wdk-starter-react-native",
                 "version":  "0.0.4",
                 "orientation":  "portrait",
                 "icon":  "./assets/images/icon.png",
                 "scheme":  "wdkstarterreactnative",
                 "ios":  {
                             "supportsTablet":  true,
                             "bundleIdentifier":  "io.tether.wdk.starter.reactnative",
                             "entitlements":  {
                                                  "com.apple.developer.icloud-services":  [
                                                                                              "CloudKit"
                                                                                          ],
                                                  "com.apple.developer.icloud-container-identifiers":  [
                                                                                                           "iCloud.io.tether.wdkshowcase"
                                                                                                       ]
                                              },
                             "infoPlist":  {
                                               "UIStatusBarStyle":  "UIStatusBarStyleLightContent",
                                               "UIViewControllerBasedStatusBarAppearance":  false,
                                               "NSFaceIDUsageDescription":  "This app uses Face ID to secure your wallet and authenticate transactions.",
                                               "ITSAppUsesNonExemptEncryption":  false
                                           }
                         },
                 "android":  {
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#0C0E12",
                                                      "foregroundImage":  "./assets/images/android-icon-foreground.png",
                                                      "backgroundImage":  "./assets/images/android-icon-background.png",
                                                      "monochromeImage":  "./assets/images/android-icon-monochrome.png"
                                                  },
                                 "edgeToEdgeEnabled":  true,
                                 "predictiveBackGestureEnabled":  false,
                                 "package":  "io.tether.wdk.starter.reactnative",
                                 "statusBar":  {
                                                   "style":  "light",
                                                   "backgroundColor":  "#000000"
                                               },
                                 "versionCode":  4
                             },
                 "web":  {
                             "output":  "static",
                             "favicon":  "./assets/images/favicon.png",
                             "bundler":  "metro"
                         },
                 "splash":  {
                                "image":  "./assets/images/splash-logo.png",
                                "resizeMode":  "contain",
                                "backgroundColor":  "#050505",
                                "dark":  {
                                             "backgroundColor":  "#050505"
                                         }
                            },
                 "userInterfaceStyle":  "light",
                 "plugins":  [
                                 "expo-router",
                                 [
                                     "expo-navigation-bar",
                                     {
                                         "visibility":  "hidden",
                                         "behavior":  "overlay-swipe"
                                     }
                                 ],
                                 [
                                     "expo-splash-screen",
                                     {
                                         "image":  "./assets/images/splash-logo.png",
                                         "imageWidth":  200,
                                         "resizeMode":  "contain",
                                         "backgroundColor":  "#050505"
                                     }
                                 ],
                                 [
                                     "expo-build-properties",
                                     {
                                         "android":  {
                                                         "minSdkVersion":  29,
                                                         "compileSdkVersion":  36,
                                                         "buildToolsVersion":  "36.0.0",
                                                         "enableProguardInReleaseBuilds":  true,
                                                         "enableShrinkResourcesInReleaseBuilds":  true,
                                                         "extraProguardRules":  "-dontwarn com.google.j2objc.annotations.ReflectionSupport\n-dontwarn com.google.j2objc.annotations.RetainedWith\n-dontwarn java.awt.Component\n-dontwarn expo.modules.core.interfaces.services.KeepAwakeManager",
                                                         "useLegacyPackaging":  true
                                                     }
                                     }
                                 ],
                                 [
                                     "@qvac/sdk/expo-plugin",
                                     {
                                         "installMissingPrebuilds":  true
                                     }
                                 ],
                                 "./modules/cloud-backup/withModularHeaders.js",
                                 "./modules/build/withCiBuildHardening.js",
                                 "expo-secure-store",
                                 [
                                     "@react-native-google-signin/google-signin",
                                     {
                                         "iosUrlScheme":  "com.googleusercontent.apps.518914426511-c46v1j9olhu5trra830bfo13cdj3ge4h"
                                     }
                                 ],
                                 [
                                     "expo-secure-store",
                                     {
                                         "configureAndroidBackup":  true
                                     }
                                 ],
                                 [
                                     "expo-camera",
                                     {
                                         "cameraPermission":  "NBX-go uses the camera to scan wallet-address QR codes.",
                                         "recordAudioAndroid":  false
                                     }
                                 ]
                             ]
             }
}
